Dialogue: 0,0:00:00.00,0:00:03.42,Default,,0,0,0,,السلام عليكم ورحمة الله
Dialogue: 0,0:00:03.42,0:00:04.28,Default,,0,0,0,,وبركاته
Dialogue: 0,0:00:04.28,0:00:06.93,Default,,0,0,0,,يوم جديد مع أولى
Dialogue: 0,0:00:06.93,0:00:09.58,Default,,0,0,0,,أو ثاني حلقات برنامج
Dialogue: 0,0:00:09.58,0:00:10.24,Default,,0,0,0,,الرحلة
Dialogue: 0,0:00:10.24,0:00:12.41,Default,,0,0,0,,منص تضيف النهاردة نجمة
Dialogue: 0,0:00:12.41,0:00:14.58,Default,,0,0,0,,من نجوم الزمن الجميل
Dialogue: 0,0:00:14.58,0:00:17.17,Default,,0,0,0,,في ناس بتلعب تينيس
Dialogue: 0,0:00:17.17,0:00:19.76,Default,,0,0,0,,ونجوم بتلعب طيرة وناس
Dialogue: 0,0:00:19.76,0:00:21.06,Default,,0,0,0,,بتلعب كورة
Dialogue: 0,0:00:21.06,0:00:23.69,Default,,0,0,0,,ضيفي وضيفكم النهاردة نجمة
Dialogue: 0,0:00:23.69,0:00:25.00,Default,,0,0,0,,كبير أسطورة
Dialogue: 0,0:00:25.00,0:00:28.20,Default,,0,0,0,,هدف كبير لزمام الأمور
Dialogue: 0,0:00:28.20,0:00:29.00,Default,,0,0,0,,مالك
Dialogue: 0,0:00:29.00,0:00:31.12,Default,,0,0,0,,لو فيه عدالة في
Dialogue: 0,0:00:31.12,0:00:33.24,Default,,0,0,0,,الكرة كاللعب أهلي وزمالك
Dialogue: 0,0:00:33.24,0:00:36.02,Default,,0,0,0,,معايا ومعاكم النهاردة النجم
Dialogue: 0,0:00:36.02,0:00:38.80,Default,,0,0,0,,الكبير كابتن حلم زدان
Dialogue: 0,0:00:38.80,0:00:41.56,Default,,0,0,0,,أحد عمالقة جيلو أو
Dialogue: 0,0:00:41.56,0:00:42.94,Default,,0,0,0,,إنشاء التعبير
Dialogue: 0,0:00:42.94,0:00:44.82,Default,,0,0,0,,ممكن نقول أحد عمالقة
Dialogue: 0,0:00:44.82,0:00:46.71,Default,,0,0,0,,الكرة في كافر دايس
Dialogue: 0,0:00:46.71,0:00:48.12,Default,,0,0,0,,وفي محافظة البحيرة
Dialogue: 0,0:00:48.12,0:00:49.80,Default,,0,0,0,,منرحب بحضرتك كابتن حلم
Dialogue: 0,0:00:49.80,0:00:51.14,Default,,0,0,0,,أهلا وسهلا كابتن ياسر
Dialogue: 0,0:00:51.14,0:00:52.14,Default,,0,0,0,,أهلا وسهلا محمد
Dialogue: 0,0:00:52.14,0:00:54.06,Default,,0,0,0,,كابتن حلم يعني بسرعة
Dialogue: 0,0:00:54.06,0:00:55.50,Default,,0,0,0,,كده هنكشف الأجواء
